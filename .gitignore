node_modules/
dist/
dist-electron/
# electron-builder 输出目录（release/ 为默认；release-<ver>/ 是绕开文件占用时的备用输出）
release*/
.vs/
*.local
.DS_Store
# 铃声库目录：保留目录结构但忽略导入的音频/封面文件
sounds/*
!sounds/.gitkeep
build.log
# 本地工作数据（助手记忆等），不入库
.workbuddy/
# 本地预览/验证用的临时目录，不入库
.preview/
verify-shell.*
shot-*.png
# headless Chrome 临时 profile（预览时会生成）
.chrome-p*/
